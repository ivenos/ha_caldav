{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [],
  "dependencyDashboard": { "enabled": false },
  "labels": ["dependencies"],
  "commitMessagePrefix": "fix(deps):",
  "commitMessageAction": "update",
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "postUpgradeTasks": {
    "commands": ["sh .github/scripts/changelog.sh dependency"],
    "dataFileTemplate": "{{{depName}}}\t{{#if (equals datasource 'docker')}}{{{currentValue}}}{{else}}{{#if currentVersion}}{{{currentVersion}}}{{else}}{{{currentValue}}}{{/if}}{{/if}}\t{{#if (equals datasource 'docker')}}{{{newValue}}}{{else}}{{#if newVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}\n",
    "fileFilters": ["CHANGELOG.md"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "commitMessagePrefix": "ci:",
      "automerge": true,
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "description": "Test tools reach no user, so they get no changelog line.",
      "matchFileNames": ["test/**", "tests/**"],
      "commitMessagePrefix": "ci:",
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "matchDepTypes": ["devDependencies"],
      "commitMessagePrefix": "ci:",
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "description": "Runs on releases only, so no pull request check covers it.",
      "matchPackageNames": ["softprops/action-gh-release"],
      "groupName": "release action",
      "automerge": false
    },
    {
      "matchDatasources": ["pypi"],
      "matchPackageNames": ["caldav", "icalendar", "vobject"],
      "enabled": false
    },
    {
      "description": "The rc branch of core carries its beta, and its latest release between two betas.",
      "matchDatasources": ["custom.home-assistant-beta"],
      "commitMessagePrefix": "ci:",
      "ignoreUnstable": false,
      "automerge": true,
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "Test dependencies",
      "commitMessagePrefix": "ci:",
      "automerge": true,
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "description": "Its betas are those of Home Assistant, which PyPI lists as pre-releases.",
      "matchPackageNames": ["pytest-homeassistant"],
      "ignoreUnstable": false
    },
    {
      "matchFileNames": [".github/scripts/screenshots.sh"],
      "commitMessagePrefix": "ci:",
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "description": "Last, because a later rule wins and the rule above matches ruff too.",
      "matchPackageNames": ["ruff"],
      "groupName": "ruff",
      "commitMessagePrefix": "ci:",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/scripts/screenshots\\.sh$/"],
      "matchStrings": ["_IMAGE=\"\\$\\{\\w+:-(?<depName>mcr\\.microsoft\\.com/playwright):(?<currentValue>[^}]+)\\}\""],
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^requirements_test\\.txt$/"],
      "matchStrings": ["(^|\\n)(?<depName>caldav|icalendar|vobject)==(?<currentValue>\\S+)"],
      "datasourceTemplate": "custom.home-assistant-beta",
      "versioningTemplate": "pep440"
    }
  ],
  "customDatasources": {
    "home-assistant-beta": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/home-assistant/core/rc/homeassistant/components/caldav/manifest.json",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $substringAfter(requirements[$substringBefore($, '==') = '{{packageName}}'], '==')}]}"
      ]
    }
  }
}
