{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [],
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "postUpgradeTasks": {
    "commands": ["sh .github/scripts/changelog.sh dependency"],
    "dataFileTemplate": "{{{depName}}}\t{{#if (equals datasource 'docker')}}{{{currentValue}}}{{else}}{{#if currentVersion}}{{{currentVersion}}}{{else}}{{{currentValue}}}{{/if}}{{/if}}\t{{#if (equals datasource 'docker')}}{{{newValue}}}{{else}}{{#if newVersion}}{{{newVersion}}}{{else}}{{{newValue}}}{{/if}}{{/if}}\n",
    "fileFilters": ["CHANGELOG.md"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "commitMessagePrefix": "ci:",
      "automerge": true,
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "description": "Test tools reach no user, so they get no changelog line.",
      "matchFileNames": ["test/**", "tests/**"],
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "matchDepTypes": ["devDependencies"],
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "description": "Runs on releases only, so no pull request check covers it.",
      "matchPackageNames": ["softprops/action-gh-release"],
      "groupName": "release action",
      "automerge": false
    },
    {
      "matchPackageNames": ["caldav", "icalendar", "vobject"],
      "enabled": false
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "Test dependencies",
      "commitMessagePrefix": "ci:",
      "automerge": true,
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "matchFileNames": [".github/scripts/screenshots.sh"],
      "postUpgradeTasks": { "commands": [] }
    },
    {
      "description": "Last, because a later rule wins and the rule above matches ruff too.",
      "matchPackageNames": ["ruff"],
      "groupName": "ruff",
      "commitMessagePrefix": "ci:",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/scripts/screenshots\\.sh$/"],
      "matchStrings": ["_IMAGE=\"\\$\\{\\w+:-(?<depName>mcr\\.microsoft\\.com/playwright):(?<currentValue>[^}]+)\\}\""],
      "datasourceTemplate": "docker"
    }
  ]
}
