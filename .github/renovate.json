{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "dependencyDashboard": false,
  "labels": ["dependencies"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "commitMessagePrefix": "ci:",
      "automerge": true
    },
    {
      "description": "Runs on tags only, so no pull request check covers it.",
      "matchPackageNames": ["softprops/action-gh-release"],
      "groupName": "release action",
      "automerge": false
    },
    {
      "matchPackageNames": ["caldav", "icalendar", "vobject"],
      "enabled": false
    },
    {
      "matchManagers": ["pip_requirements"],
      "groupName": "Test dependencies",
      "commitMessagePrefix": "ci:",
      "automerge": true
    },
    {
      "description": "Last, because a later rule wins and the rule above matches ruff too.",
      "matchPackageNames": ["ruff"],
      "groupName": "ruff",
      "commitMessagePrefix": "ci:",
      "automerge": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/scripts/screenshots\\.sh$/"],
      "matchStrings": ["_IMAGE=\"\\$\\{\\w+:-(?<depName>mcr\\.microsoft\\.com/playwright):(?<currentValue>[^}]+)\\}\""],
      "datasourceTemplate": "docker"
    }
  ]
}
